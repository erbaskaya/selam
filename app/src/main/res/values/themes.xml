<resources>
    <style name="Theme.Selam" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/selam_navy</item>
        <item name="android:navigationBarColor">@color/selam_navy</item>
        <item name="android:colorAccent">@color/selam_blue</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Selam.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#559FFF</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
